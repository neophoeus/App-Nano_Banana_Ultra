# Paid Tier key: from a Google Cloud project WITH billing enabled.
# Used for all Nano Banana image models, Google Search / Image Search grounding, Batch API, video uploads (Files API),
# and all prompt tools when in Quality Mode (locked to gemini-3.8-flash without model downgrade).
GEMINI_PAID_API_KEY=YOUR_PAID_API_KEY_HERE

# Free Tier key: from a SEPARATE Google Cloud project WITHOUT billing.
# Used in Eco Mode for free-eligible prompt tools and safety analysis with smart 3-stage cascading fallback:
# free:gemini-3.8-flash -> free:gemini-3.5-flash-lite -> paid:gemini-3.8-flash.
# Billing applies per project, so a key from a billed project is always charged, even for free-quota models.
GEMINI_FREE_API_KEY=YOUR_FREE_API_KEY_HERE

# Optional: comma-separated models routed to the Free Tier key (default: gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite).
# GEMINI_FREE_TIER_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Legacy single key (still supported). Treated as the Paid Tier key when GEMINI_PAID_API_KEY is not set.
# If only one key is configured, all requests fall back to that key.
# GEMINI_API_KEY=YOUR_API_KEY_HERE
