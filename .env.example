# Paid Tier key: from a Google Cloud project WITH billing enabled.
# Used for all Nano Banana image models, Google Search / Image Search grounding, Batch API, and video uploads (Files API).
GEMINI_PAID_API_KEY=YOUR_PAID_API_KEY_HERE

# Free Tier key: from a SEPARATE Google Cloud project WITHOUT billing.
# Used for free-eligible models (prompt enhancer, random prompt, image-to-prompt, safety keyword analysis on gemini-3.8-flash).
# Billing applies per project, so a key from a billed project is always charged, even for free-quota models.
GEMINI_FREE_API_KEY=YOUR_FREE_API_KEY_HERE

# Optional: comma-separated models routed to the Free Tier key (default: gemini-3.8-flash).
# GEMINI_FREE_TIER_MODELS=gemini-3.8-flash

# Legacy single key (still supported). Treated as the Paid Tier key when GEMINI_PAID_API_KEY is not set.
# If only one key is configured, all requests fall back to that key.
# GEMINI_API_KEY=YOUR_API_KEY_HERE
